 n),\n","    \"Days_Before_Event\": rng.integers(0, 61, n),\n","    \"After_Office_Hours\": rng.choice([\"Yes\", \"No\"], n),\n","    \"Purpose\": rng.choice(\n","        [\"Meeting\", \"Academic\", \"Seminar\", \"Sports\", \"Event\"],\n","        n\n","    ),\n","    \"Usage_Status\": rng.choice(\n","        [\"Used\", \"Cancelled\", \"No-Show\"],\n","        n,\n","        p=[0.70, 0.20, 0.10]\n","    ),\n","    \"Actual_Attendance\": rng.integers(0, 151, n),\n","    \"Cancellation_Days_Before\": rng.choice(\n","        [np.nan, 0, 1, 2, 3, 7, 14], n\n","    )\n","})\n","\n","df.loc[5, \"Participants\"] = np.nan\n","df.loc[12, \"Facility_Type\"] = \"classroom\"\n","df.loc[20, \"Duration_Hours\"] = -2\n","df.loc[30, \"User_Type\"] = None\n","df.loc[40, \"Actual_Attendance\"] = np.nan\n","df.loc[50] = df.loc[49]  # Intentional duplicate transaction\n","\n","df.to_csv(\"facility_reservations.csv\", index=False)\n","print(\"Synthetic CSV created:\", df.shape)\n","\n","\n","original_df = pd.read_csv(\"facility_reservations.csv\")\n","original_df.to_csv(\"facility_reservations_original.csv\", index=False)\n","\n","print(\"\\nFIRST 10 RECORDS\")\n","display(original_df.head(10))\n","\n","print(\"\\nDATASET DIMENSIONS\")\n","print(\"Rows:\", original_df.shape[0])\n","print(\"Columns:\", original_df.shape[1])\n","\n","print(\"\\nDATA TYPES\")\n","print(original_df.dtypes)\n","\n","print(\"\\nSUMMARY STATISTICS\")\n","display(original_df.describe(include=\"all\").T)\n","\n","print(\"\\nMISSING VALUES\")\n","print(original_df.isnull().sum())\n","\n","print(\"\\nDUPLICATE ROWS\")\n","print(original_df.duplicated().sum())\n","\n","clean_df = original_df.copy()\n","\n","rows_before = len(clean_df)\n","duplicates_before = clean_df.duplicated().sum()\n","missing_before = clean_df.isnull().sum().sum()\n","\n","for col in [\"User_Type\", \"Facility_Type\",\n","            \"After_Office_Hours\", \"Purpose\", \"Usage_Status\"]:\n","    clean_df[col] = clean_df[col].apply(\n","        lambda x: x.strip().title() if isinstance(x, str) else x\n","    )\n","\n","\n","clean_df = clean_df.drop_duplicates().copy()\n","\n","# Replace invalid numeric values with missing values.\n","for col in [\"Duration_Hours\", \"Participants\", \"Actual_Attendance\"]:\n","    clean_df.loc[clean_df[col] < 0, col] = np.nan\n","\n","\n","def categorize_lead_time(days):\n","    if pd.isna(days):\n","        return np.nan\n","    if 0 <= days <= 2:\n","        return \"Last Minute\"\n","    elif 3 <= days <= 7:\n","        return \"Short Lead\"\n","    elif 8 <= days <= 14:\n","        return \"Medium Lead\"\n","    elif days > 14:\n","        return \"Early Booking\"\n","    return np.nan\n","\n","clean_df[\"Lead_Time_Category\"] = (\n","    clean_df[\"Days_Before_Event\"].apply(categorize_lead_time)\n",")\n","\n","\n","clean_df[\"Reservation_Outcome\"] = clean_df[\"Usage_Status\"].map({\n","    \"Used\": \"Completed\",\n","    \"Cancelled\": \"Not Completed\",\n","    \"No-Show\": \"Not Completed\"\n","})\n","\n","\n","clean_df[\"Attendance_Ratio\"] = (\n","    clean_df[\"Actual_Attendance\"] /\n","    clean_df[\"Participants\"].replace(0, np.nan)\n",")\n","\n","print(\"\\nCLEANING SUMMARY\")\n","print(\"Rows before cleaning:\", rows_before)\n","print(\"Duplicate rows found:\", duplicates_before)\n","print(\"Missing cells before cleaning:\", missing_before)\n","print(\"Rows after duplicate removal:\", len(clean_df))\n","print(\"\\nRemaining missing values:\")\n","print(clean_df.isnull().sum())\n","\n","clean_df.to_csv(\"facility_reservations_cleaned.csv\", index=False)\n","print(\"\\nSaved cleaned CSV.\")\n","\n","\n","analysis_df = clean_df.copy()\n","\n","print(\"\\nRESERVATION COUNT BY FACILITY\")\n","facility_counts = analysis_df[\"Facility_Type\"].value_counts()\n","display(facility_counts)\n","\n","facility_counts.plot(kind=\"bar\")\n","plt.title(\"Reservation Count by Facility Type\")\n","plt.xlabel(\"Facility Type\")\n","plt.ylabel(\"Number of Reservations\")\n","plt.xticks(rotation=30)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","analysis_df[\"Is_Not_Completed\"] = (\n","    analysis_df[\"Usage_Status\"].isin([\"Cancelled\", \"No-Show\"])\n",")\n","\n","user_summary = analysis_df.groupby(\"User_Type\")[\n","    \"Is_Not_Completed\"\n","].agg([\"sum\", \"count\"])\n","\n","user_summary[\"Percentage\"] = (\n","    user_summary[\"sum\"] / user_summary[\"count\"] * 100\n",")\n","\n","print(\"\\nCANCELLATION/NO-SHOW BY USER TYPE\")\n","display(user_summary)\n","\n","user_summary[\"Percentage\"].plot(kind=\"bar\")\n","plt.title(\"Cancellation/No-Show Percentage by User Type\")\n","plt.xlabel(\"User Type\")\n","plt.ylabel(\"Percentage (%)\")\n","plt.xticks(rotation=30)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","lead_outcome = pd.crosstab(\n","    analysis_df[\"Lead_Time_Category\"],\n","    analysis_df[\"Reservation_Outcome\"],\n","    normalize=\"index\"\n",") * 100\n","\n","print(\"\\nOUTCOME PERCENTAGE BY LEAD-TIME CATEGORY\")\n","display(lead_outcome.round(2))\n","\n","lead_outcome.plot(kind=\"bar\")\n","plt.title(\"Reservation Outcome by Lead-Time Category\")\n","plt.xlabel(\"Lead-Time Category\")\n","plt.ylabel(\"Percentage within each category (%)\")\n","plt.xticks(rotation=30)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","predictors = [\n","    \"User_Type\",\n","    \"Facility_Type\",\n","    \"Duration_Hours\",\n","    \"Participants\",\n","    \"Days_Before_Event\",\n","    \"After_Office_Hours\",\n","    \"Purpose\"\n","]\n","target = \"Reservation_Outcome\"\n","\n","model_df = clean_df.dropna(subset=[target]).copy()\n","\n","\n","model_df = model_df.dropna(subset=predictors).copy()\n","\n","X = model_df[predictors]\n","y = model_df[target]\n","\n","if y.nunique() < 2:\n","    print(\"Model cannot be trained: target has only one class.\")\n","else:\n","    X_train, X_test, y_train, y_test = train_test_split(\n","        X, y,\n","        test_size=0.20,\n","        random_state=42,\n","        stratify=y\n","    )\n","\n","    categorical_features = [\n","        \"User_Type\", \"Facility_Type\",\n","        \"After_Office_Hours\", \"Purpose\"\n","    ]\n","    numerical_features = [\n","        \"Duration_Hours\", \"Participants\", \"Days_Before_Event\"\n","    ]\n","\n","    preprocessing = ColumnTransformer([\n","        (\"categorical\", OneHotEncoder(handle_unknown=\"ignore\"),\n","         categorical_features),\n","        (\"numerical\", \"passthrough\", numerical_features)\n","    ])\n","\n","    model = Pipeline([\n","        (\"preprocessing\", preprocessing),\n","        (\"classifier\", DecisionTreeClassifier(random_state=42))\n","    ])\n","\n","    model.fit(X_train, y_train)\n","    predictions = model.predict(X_test)\n","\n","    print(\"\\nCONFUSION MATRIX\")\n","    labels = model.named_steps[\"classifier\"].classes_\n","    cm = confusion_matrix(y_test, predictions, labels=labels)\n","    display(pd.DataFrame(\n","        cm,\n","        index=[f\"Actual {label}\" for label in labels],\n","        columns=[f\"Predicted {label}\" for label in labels]\n","    ))\n","\n","    ConfusionMatrixDisplay(\n","        confusion_matrix=cm,\n","        display_labels=labels\n","    ).plot()\n","    plt.title(\"Decision Tree Confusion Matrix\")\n","    plt.tight_layout()\n","    plt.show()\n","\n","\n","    positive_label = \"Not Completed\"\n","    binary_y_test = (y_test == positive_label).astype(int)\n","    binary_predictions = (predictions == positive_label).astype(int)\n","\n","    print(\"Accuracy:\", accuracy_score(y_test, predictions))\n","    print(\"Precision:\", precision_score(\n","        binary_y_test, binary_predictions, zero_division=0\n","    ))\n","    print(\"Recall:\", recall_score(\n","        binary_y_test, binary_predictions, zero_division=0\n","    ))\n","    print(\"F1-score:\", f1_score(\n","        binary_y_test, binary_predictions, zero_division=0\n","    ))\n","\n","    feature_names = (\n","        model.named_steps[\"preprocessing\"]\n","        .get_feature_names_out()\n","    )\n","    importances = (\n","        model.named_steps[\"classifier\"].feature_importances_\n","    )\n","    importance_df = pd.DataFrame({\n","        \"Feature\": feature_names,\n","        \"Importance\": importances\n","    }).sort_values(\"Importance\", ascending=False)\n","\n","    print(\"\\nTOP THREE MODEL FEATURES\")\n","    display(importance_df.head(3))\n","\n","\n","fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n","\n","facility_counts.plot(kind=\"bar\", ax=axes[0])\n","axes[0].set_title(\"OBSERVED: Reservation Counts\")\n","axes[0].set_xlabel(\"Facility Type\")\n","axes[0].set_ylabel(\"Count\")\n","\n","user_summary[\"Percentage\"].plot(kind=\"bar\", ax=axes[1])\n","axes[1].set_title(\"OBSERVED: Cancellation/No-Show (%)\")\n","axes[1].set_xlabel(\"User Type\")\n","axes[1].set_ylabel(\"Percentage (%)\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"\\nFILES CREATED:\")\n","for filename in [\n","    \"facility_reservations.csv\",\n","    \"facility_reservations_original.csv\",\n","    \"facility_reservations_cleaned.csv\"\n","]:\n","    print(filename, \"-\", os.path.getsize(filename), \"bytes\")\n","\n","print(\"\\nReview all TODO sections before using your notebook.\")"]},{"cell_type":"code","source":["\n","clean_df = original_df.copy()\n","rows_before = len(clean_df)\n","\n","print(f\"Rows before: {rows_before}\")\n","print(f\"Duplicates found: {clean_df.duplicated().sum()}\")\n","print(f\"Missing before:\\n{clean_df.isnull().sum()}\")\n","\n","for col in [\"User_Type\", \"Facility_Type\", \"After_Office_Hours\", \"Purpose\", \"Usage_Status\"]:\n","    clean_df[col] = clean_df[col].apply(\n","        lambda x: x.strip().title() if isinstance(x, str) else x\n","    )\n","\n","clean_df = clean_df.drop_duplicates().copy()\n","\n","for col in [\"Duration_Hours\", \"Participants\", \"Actual_Attendance\"]:\n","    clean_df.loc[clean_df[col] < 0, col] = np.nan\n","\n","clean_df['